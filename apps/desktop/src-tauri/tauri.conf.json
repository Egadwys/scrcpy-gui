{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrcpy GUI",
  "version": "0.1.0",
  "identifier": "dev.scrcpygui.app",
  "build": {
    "beforeDevCommand": "pnpm fetch-scrcpy && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm fetch-scrcpy --strict && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scrcpy GUI",
        "width": 560,
        "height": 720,
        "minWidth": 460,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Mirror and control Android devices with scrcpy",
    "longDescription": "A desktop interface for scrcpy: detect devices, connect over Wi-Fi, mirror, record and take screenshots without the terminal.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/scrcpy/**/*"
    ]
  }
}
